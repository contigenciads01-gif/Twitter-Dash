# Porta da API
PORT=3001
NODE_ENV=development

# URL do Banco de Dados SQLite
DATABASE_URL="file:./twitter_dash.db"

# Fuso horário padrão
TZ="America/Sao_Paulo"

# Chave secreta JWT para autenticação das rotas da API
JWT_SECRET="seu-jwt-secret-super-seguro-aqui-123456"

# Credenciais de acesso ao Twitter/X (utilizadas pelo twitter-mcp-server)
# Login direto via scraping:
TWITTER_USERNAME=""
TWITTER_PASSWORD=""
TWITTER_EMAIL=""

# Credenciais opcionais da API Oficial do X (Twitter Developer Portal):
TWITTER_API_KEY=""
TWITTER_API_SECRET_KEY=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""

# Caminho relativo ou absoluto para o twitter-mcp-server compilado
MCP_SERVER_PATH="../twitter-mcp-server/build/index.js"

# Intervalo mínimo padrão entre publicações em segundos (para proteção contra bloqueio)
MIN_POST_INTERVAL_SECONDS=60

# Configurações do Scheduler
SCHEDULER_ENABLED=true
ANALYTICS_CRON_ENABLED=true
